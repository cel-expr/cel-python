from collections.abc import MutableMapping, Sequence
from typing import Any, TypedDict

from cel_expr_python import cel

class ValueString:
  @property
  def id(self) -> int: ...
  @property
  def value(self) -> str: ...
  def __repr__(self) -> str: ...

class Import:
  @property
  def id(self) -> int: ...
  @property
  def name(self) -> ValueString: ...
  def __repr__(self) -> str: ...

class Variable:
  @property
  def name(self) -> ValueString: ...
  @property
  def expression(self) -> ValueString: ...
  @property
  def description(self) -> ValueString | None: ...
  @property
  def display_name(self) -> ValueString | None: ...
  def __repr__(self) -> str: ...

class OutputBlock:
  def __init__(self, output: ValueString = ..., explanation: ValueString | None = ...) -> None: ...
  @property
  def output(self) -> ValueString: ...
  @output.setter
  def output(self, value: ValueString) -> None: ...
  @property
  def explanation(self) -> ValueString | None: ...
  @explanation.setter
  def explanation(self, value: ValueString | None) -> None: ...
  def __repr__(self) -> str: ...

class Match:
  @property
  def id(self) -> int: ...
  @property
  def condition(self) -> ValueString: ...
  @property
  def has_output_block(self) -> bool: ...
  @property
  def output_block(self) -> OutputBlock: ...
  @property
  def has_rule(self) -> bool: ...
  @property
  def rule(self) -> Rule: ...
  def set_result(self, result: OutputBlock | Rule) -> None: ...
  def __repr__(self) -> str: ...

class Rule:
  def __init__(self) -> None: ...
  @property
  def id(self) -> int: ...
  @property
  def rule_id(self) -> ValueString | None: ...
  @property
  def description(self) -> ValueString | None: ...
  @property
  def variables(self) -> Sequence[Variable]: ...
  @variables.setter
  def variables(self, value: Sequence[Variable]) -> None: ...
  @property
  def matches(self) -> list[Match]: ...
  @matches.setter
  def matches(self, value: Sequence[Match]) -> None: ...
  @property
  def is_aggregate(self) -> bool: ...
  @is_aggregate.setter
  def is_aggregate(self, value: bool) -> None: ...
  def __repr__(self) -> str: ...

class CelPolicy:
  @property
  def name(self) -> ValueString: ...
  @property
  def description(self) -> ValueString | None: ...
  @property
  def display_name(self) -> ValueString | None: ...
  @property
  def imports(self) -> Sequence[Import]: ...
  @imports.setter
  def imports(self, value: Sequence[Import]) -> None: ...
  @property
  def rule(self) -> Rule: ...
  @rule.setter
  def rule(self, value: Rule) -> None: ...
  @property
  def metadata(self) -> CelPolicyMetadata: ...
  def __repr__(self) -> str: ...

class CelPolicyMetadata(MutableMapping[str, Any]): ...

class CelPolicySource:
  def __repr__(self) -> str: ...

class CelPolicyIssue:
  def to_display_string(self, source: CelPolicySource) -> str: ...

class CelPolicyParseResult:
  @property
  def is_valid(self) -> bool: ...
  def policy(self) -> CelPolicy: ...
  def release_policy(self) -> CelPolicy: ...
  def issues(self) -> Sequence[CelPolicyIssue]: ...
  def formatted_issues(self) -> str: ...



class YAMLNode:
  def is_scalar(self) -> bool: ...
  def is_sequence(self) -> bool: ...
  def is_map(self) -> bool: ...
  def __len__(self) -> int: ...
  def __getitem__(self, key: Any) -> Any: ...

class CelPolicyParseContext:
  @property
  def policy(self) -> CelPolicy: ...
  def report_error(self, id: int, message: str) -> None: ...
  def collect_metadata(self, node: YAMLNode) -> int: ...

class CelPolicyYamlParser:
  def __init__(self) -> None: ...
  def parse(self, yaml_content: str) -> CelPolicyParseResult: ...
  def parse_policy_tag(self, ctx: CelPolicyParseContext, tag_name: ValueString, node: YAMLNode) -> bool: ...
  def parse_rule(self, ctx: CelPolicyParseContext, node: YAMLNode, rule: Rule) -> None: ...
  def parse_rule_tag(self, ctx: CelPolicyParseContext, tag_name: ValueString, node: YAMLNode, rule: Rule) -> bool: ...
  def parse_variable(self, ctx: CelPolicyParseContext, node: YAMLNode, rule: Rule) -> Variable: ...
  def parse_variable_tag(self, ctx: CelPolicyParseContext, tag_name: ValueString, node: YAMLNode, variable: Variable) -> bool: ...
  def parse_match_tag(self, ctx: CelPolicyParseContext, tag_name: ValueString, node: YAMLNode, match: Match, rule: Rule) -> bool: ...
  def parse_match(self, ctx: CelPolicyParseContext, node: YAMLNode, rule: Rule) -> Match: ...
  def get_value_string(self, ctx: CelPolicyParseContext, node: YAMLNode, error_message: str) -> ValueString | None: ...

def parse_yaml_cel_policy(yaml_content: str, parser: CelPolicyYamlParser | None = ..., description: str | None = ...) -> CelPolicyParseResult: ...

class CompilePolicyOptions(TypedDict, total=False):
  unnesting_height_limit: int

class CelPolicyValidationResult:
  @property
  def is_valid(self) -> bool: ...
  def expression(self) -> cel.Expression: ...
  def issues(self) -> Sequence[CelPolicyIssue]: ...
  def formatted_issues(self) -> str: ...

def compile(env: cel.Env, policy: CelPolicy, options: CompilePolicyOptions | None = ...) -> CelPolicyValidationResult: ...

